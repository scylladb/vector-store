//! Binary (fbin/ibin) dataset loaders for vector-search workloads.
//!
//! A benchmark dataset is three files in the big-ann-benchmarks binary
//! formats:
//!
//!   base vectors  - fbin: header `count: u32 LE, dimension: u32 LE`, then
//!                   count x dimension f32 LE; ids are the record indices.
//!   query vectors - fbin, same layout.
//!   ground truth  - ibin: same header (`count, k`), then count x k u32 LE
//!                   neighbour ids (nearest first), aligned with the query
//!                   file. Official big-ann files append count x k f32
//!                   distances; both layouts are accepted (distances unread).

/// Byte length of the `count, dimension` header that precedes the records.
const HEADER_LEN = 8;

/// Byte offset of record `id` in a file of `dimension`-component records.
fn record_offset(dimension, id) {
    HEADER_LEN + id * dimension * 4
}

/// Read an fbin header, returning `#{ count, dimension }` validated against the
/// file length.
fn read_fbin_header(file, path) {
    let count = file.read_u32(fs::LE)?;
    let dimension = file.read_u32(fs::LE)?;
    let expected = record_offset(dimension, count);
    if file.len() != expected {
        let hint = "";
        if file.len() < expected && dimension > 0 {
            let holds = (file.len() - HEADER_LEN) / (dimension * 4);
            hint = `; truncated or unpatched prefix crop (holds ${holds} whole \
                records; for a crop, patch header count to ${holds})`;
        }
        return Err(`${path}: file is ${file.len()} bytes, header ${count} x \
            ${dimension} implies ${expected}${hint}`);
    }
    Ok(#{ "count": count, "dimension": dimension })
}

/// Read and validate a base-vector file's header without reading any records.
/// Pairs with the `read_base_vector*_at` readers: the file stays on disk and
/// one record is read per cycle. fbin has no bucket column, so
/// `recall_buckets.rn` uses the text loader and never comes here.
pub fn read_base_header(path) {
    let file = fs::open_binary(path)?;
    read_fbin_header(file, path)
}

/// Read record `id` of an open base-vector file as a Vec<f64>. `header` is the
/// one `read_base_header` returned for this file; open the file with
/// `fs::open_binary` in `prepare_worker`, since a handle cannot travel through
/// `ctx.data`.
pub fn read_base_vector_at(file, header, id) {
    file.seek(record_offset(header.dimension, id))?;
    Ok(file.read_f32_vec(fs::LE, header.dimension)?)
}

/// Like `read_base_vector_at`, but returns the record as packed little-endian
/// f32 bytes, which latte binds to `vector<float, N>` directly. Bind-only:
/// script code cannot index the components.
pub fn read_base_vector_packed_at(file, header, id) {
    file.seek(record_offset(header.dimension, id))?;
    Ok(file.read_bytes(header.dimension * 4)?)
}

/// Load an fbin query-vector file into a Vec of Vec<f64>.
pub async fn load_query_vectors(path) {
    let file = fs::open_binary(path)?;
    let header = read_fbin_header(file, path)?;
    let rows = [];
    for _ in 0..header.count {
        rows.push(file.read_f32_vec(fs::LE, header.dimension)?);
    }
    Ok(rows)
}

/// Load a ground-truth file into a Vec of Vec<i64> (k neighbour ids per query,
/// nearest first). Accepts the bare ibin layout and the official layout with
/// appended f32 distances (not read).
pub async fn load_ground_truth(path) {
    let file = fs::open_binary(path)?;
    let count = file.read_u32(fs::LE)?;
    let k = file.read_u32(fs::LE)?;
    let ids_only = HEADER_LEN + count * k * 4;
    let with_distances = HEADER_LEN + count * k * 8;
    if file.len() != ids_only && file.len() != with_distances {
        return Err(`${path}: file is ${file.len()} bytes, expected ${ids_only} \
            (ids) or ${with_distances} (ids + distances) for ${count} x ${k}`);
    }
    let rows = [];
    for _ in 0..count {
        rows.push(file.read_u32_vec(fs::LE, k)?);
    }
    Ok(rows)
}
