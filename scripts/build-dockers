#!/bin/bash

set -e

repo=$(dirname "${BASH_SOURCE[0]}")
repo=$(realpath $repo/..)

cd $repo

vector_store_version=$(./scripts/run-with-release-toolchain cargo info vector-store | grep ^version: | cut -d ' ' -f 2)

# architectures to build could be given as arguments (a subset of the default
# list), e.g. `./scripts/build-dockers arm64`; defaults to all release
# architectures
archs="${*:-amd64 arm64}"

dockerfile=$(cat <<EOF
FROM redhat/ubi9-minimal
ARG TARGETARCH
RUN mkdir /opt/vector-store
COPY target/\$TARGETARCH/release/vector-store /opt/vector-store
CMD ["/opt/vector-store/vector-store"]
EOF
)

docker_tag=scylladb/vector-store:$vector_store_version
for arch in $archs ; do
    echo Build the docker image for linux/$arch
    docker build --platform linux/$arch --tag $docker_tag-$arch -f- . <<EOF
$dockerfile
EOF
done

# the multi-arch image is not built here: the default docker driver cannot
# store a multi-platform image in the classic image store, so the combined
# tag is assembled from the pushed per-arch images at upload time (see
# scripts/upload-dockers and the release workflow)

docker images -f "reference=$docker_tag*"
