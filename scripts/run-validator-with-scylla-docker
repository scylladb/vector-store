#!/bin/bash

set -e

usage() {
    echo "usage: $0 <docker-scylla-tag> <vector-store-bin-path> <vector-search-validator-bin-path>"
    exit 1
}

scylla_tag=$1
[[ -n $scylla_tag ]] || usage

vector_store=$(realpath $2)
[[ -x $vector_store ]] || usage

validator=$(realpath $3)
[[ -x $validator ]] || usage

shift 3

dns_ip=127.0.1.1
base_ip=127.0.2.1

# The tests log to a file each, which is of no use inside a container that is
# thrown away when the run ends. Mount a directory for them at the same path
# the container writes to, so the path the run reports can be opened as it is.
# The files belong to root, the user the container runs as.
log_dir=${VALIDATOR_LOG_DIR:-/tmp/vector-search-validator-logs}
mkdir -p "$log_dir"

# The run reports its progress by repainting the console, which it only does
# when it is writing to a terminal. Give the container one, and the width to
# lay the report out in, whenever this script was started from a terminal
# itself. In CI there is none, and the run reports a line per event instead.
if [[ -t 1 ]] ; then
    # Only a terminal, not an attached stdin: the run reads none, and leaving
    # stdin alone keeps Ctrl-C reaching docker as it does today.
    tty_opts="--tty --env COLUMNS=$(tput cols)"
fi

# Each group owning a cluster runs in a network namespace of its own, so that
# the clusters do not have to share the loopback addresses, the ports and the
# routing table they all claim. Creating one needs SYS_ADMIN, which is not
# among the capabilities a container is given by default.
docker run --rm \
    $tty_opts \
    --cap-add NET_ADMIN \
    --cap-add SYS_ADMIN \
    --user root \
    --security-opt seccomp=unconfined \
    --dns=$dns_ip \
    --dns-search=. \
    --volume="$vector_store:/vector-store" \
    --volume="$validator:/vector-search-validator" \
    --volume="$log_dir:$log_dir" \
    --network=none \
    --entrypoint=/vector-search-validator \
    $scylla_tag \
    run --dns-ip $dns_ip --base-ip $base_ip --scylla-default-conf /etc/scylla/scylla.yaml --log-dir "$log_dir" /usr/bin/scylla /vector-store "$@"
